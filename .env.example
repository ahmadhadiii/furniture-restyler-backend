PORT=3000

# Forge Neo running locally on this PC, GPU 0 - used ONLY for ControlNet
# segmentation (auto-mask detection) now. Actual generation moved to Fooocus-API.
A1111_BASE_URL=http://localhost:7860

# Fooocus-API (wraps the Fooocus SDXL install on GPU 1) - does the actual
# furniture generation via its inpaint-outpaint endpoint.
FOOOCUS_API_BASE_URL=http://localhost:8888

# Legacy single shared LoRA - kept only as the fallback for the no-roomType
# dev/test-page path (explicit prompt override). The real app always sends a
# roomType now, which uses one of the per-category LoRAs below instead - one
# shared LoRA + trigger covering every furniture type caused type bleeding
# (bedroom requests sometimes rendering couch/chair-shaped furniture).
LORA_NAME=homecenter-furniture-sdxl
LORA_WEIGHT=0.8
TRIGGER_WORDS=hmcntrfrn

# Per-category LoRAs, each trained only on that furniture type
# (kohya_ss/datasets/homecenter-furniture-<category>) - see
# prompt-catalog.ts's TRIGGER_WORDS_BY_ROOM_TYPE for the matching trigger word
# each one expects, and restyle.service.ts's resolveLora()/
# LORA_ENV_PREFIX_BY_ROOM_TYPE for the lookup. All four room types have been
# retrained as of 2026-08.
LORA_SOFA_NAME=homecenter-furniture-sofa-sdxl
LORA_SOFA_WEIGHT=0.8
LORA_SECTIONAL_NAME=homecenter-furniture-sectional-sdxl
LORA_SECTIONAL_WEIGHT=0.8
LORA_BED_NAME=homecenter-furniture-bed-sdxl
LORA_BED_WEIGHT=0.8
LORA_DINING_NAME=homecenter-furniture-dining-sdxl
LORA_DINING_WEIGHT=0.8

# Prompt template - {trigger} is substituted automatically. LoRA is no longer
# inline prompt syntax (that was an A1111-ism) - Fooocus-API takes it as a
# structured `loras` field built from LORA_NAME/LORA_WEIGHT above instead.
DEFAULT_PROMPT=professional interior photo, {trigger}, a single modern sofa facing a coffee table on a rug, high quality, realistic lighting, photorealistic
NEGATIVE_PROMPT=blurry, low quality, distorted, empty room, deformed furniture, watermark, text, cluttered, messy, scattered, floating objects, duplicate, overlapping furniture, multiple sofas

# Fooocus-API tuning. DENOISING_STRENGTH maps to inpaint_strength, CFG_SCALE
# maps to guidance_scale - both exposed directly. Fooocus bundles steps into
# named performance presets rather than a raw integer, and sampler/scheduler
# are ComfyUI-style names (not A1111's "DPM++ 2M Karras" string) so STEPS and
# SAMPLER_NAME from the old A1111 setup don't carry over - left unset to
# inherit Fooocus's own proven-good defaults (same as the manual GUI testing
# that validated this LoRA).
DENOISING_STRENGTH=0.85
CFG_SCALE=7.5
PERFORMANCE_SELECTION=Quality
